# === ENVIRONNEMENT ===
.env
.env.local
.env.*.local
!.env.dist
!backend/.env
local/*

# === BACKEND SYMFONY ===
backend/vendor/
backend/var/
backend/config/jwt/
backend/.env.local
backend/.env.*.local

# === SCRIPTS ===
scripts/vendor/
# Toolkit DI container cache + runtime (ServiceContainerManager dumps to <root>/var/).
/var/
# Portals: relative symlinks to sibling clones, posed locally (see AGENTS.md), not committed.
scripts/toolkit
scripts/backlog

# === FRONTEND REACT ===
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env.local

# === SKILLS ===
skills/imported/
!skills/custom/.gitkeep
!skills/imported/.gitkeep

# === DOCKER ===
docker/data/
.docker/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# === LOGS ===
*.log
logs/

# === OS ===
desktop.ini

# === Agents ===
.claude/worktrees/
.claude/settings.local.json
.worktrees/
.agent-worktrees/
.codex
.githooks/

# === Global ===
!.gitkeep

# >>> backlog — managed block, do not edit between markers
# Local backlog files — never committed: config.yaml is tuned locally (no override system yet),
# board/review/locks/logs/migrations are per-checkout runtime.
/backlog/config.yaml
/backlog/board.yaml
/backlog/board/
/backlog/review.md
/backlog/review-result.txt
/backlog/lock
/backlog/log
/backlog/migrations.applied
# <<< backlog

# >>> toolkit-portal — managed block, do not edit between markers
# toolkit portal: relative symlink to the sibling package public folder, posed locally, not committed.
/scripts/toolkit
# <<< toolkit-portal

# >>> toolkit-hooks — managed block, do not edit between markers
# toolkit/hooks/ content: hook symlinks posed by operator/provisioning, not committed. The directory itself (.gitkeep) is tracked.
/toolkit/hooks/*
!/toolkit/hooks/.gitkeep
# <<< toolkit-hooks

# >>> backlog-portal — managed block, do not edit between markers
# backlog portal: relative symlink to the sibling package public folder, posed locally, not committed.
/scripts/backlog
# <<< backlog-portal
